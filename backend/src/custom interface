import express, { Request } from 'express';
import mongoose from 'mongoose';
import { IAvailability } from '../models/Availability';
import Availability from '../models/Availability';
import authMiddleware from '../middleware/authMiddleware';

interface CustomRequest extends Request {
  user?: {
    userId: string;
  };
}

// Create the router
const router = express.Router();

router.post('/', authMiddleware, async (req: CustomRequest, res) => {
  const userIdStr = req.user?.userId;

  if (!userIdStr || !mongoose.Types.ObjectId.isValid(userIdStr)) {
    return res.status(400).json({ error: 'Invalid user ID' });
  }

  const userId = new mongoose.Types.ObjectId(userIdStr);
  const { days, startTime, endTime } = req.body;

  try {
    // Use the imported model
    let availability: IAvailability | null = await Availability.findOne({ user: userId });

    if (availability) {
      // update existing record
      availability.days = days || availability.days;
      availability.startTime = startTime || availability.startTime;
      availability.endTime = endTime || availability.endTime;
      await availability.save();
    } else {
      // create new record
      availability = new Availability({ user: userId, days, startTime, endTime });
      await availability.save();
    }
    res.json(availability);
  } catch (err: any) {
    res.status(500).json({ error: err.message });
  }
});

export default router;